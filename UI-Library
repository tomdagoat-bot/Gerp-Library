const Main_Properties = {butt = true,"BackgroundTransparency","TextTransparency","TextStrokeTransparency","ImageTransparency"}

function Window_UIObject(Obj,Theme)
	if not Obj:IsA("GuiObject") then return end

	if Obj.Name == "Bar" then
		Obj.BackgroundColor3 = Theme["Bar"]
		Obj.BackgroundTransparency = Theme["Bar Transparency"]
	elseif Obj.Name == "Fill" then
		Obj.BackgroundColor3 = Theme["Fill Color"] or Theme["Light Color"] 
		Obj.BackgroundTransparency = Theme["Fill Transparency"]
	end

	if Obj:GetAttribute("Main-UI") then
		Obj.BackgroundColor3 = Theme["Main Background"]
		Obj.BackgroundTransparency = Theme["Background Transparency"]
	elseif Obj:GetAttribute("Secondary-UI") then
		Obj.BackgroundColor3 = Theme["Secondary"]
		Obj.BackgroundTransparency = Theme["Secondary Transparency"]
	elseif Obj:GetAttribute("Tertiary-UI") then
		Obj.BackgroundColor3 = Theme["Tertiary"]
		Obj.BackgroundTransparency = Theme["Tertiary Transparency"]
	end

	if (Obj.Name == "Icon" or Obj:GetAttribute("Icon")) and Has_Property(Obj,"Image") then
		Obj.ImageColor3 = Obj:GetAttribute("Color") or Theme["Icon Color"]
		Obj.ImageTransparency = Theme["Icon Transparency"]
	end

	for _, Prop in Main_Properties do
		if Has_Property(Obj,Prop) then
			Obj:SetAttribute(Prop,Obj[Prop])
		end
	end

end

function Window_TextObject(Obj,Theme,Font)
	if not IsA_TextObj(Obj) then return end
	Obj.FontFace = Font
	if Obj:GetAttribute("Secondary-Text") then
		Obj.TextColor3 = Theme["Secondary Text Color"]
		Obj.TextTransparency = Theme["Secondary Text Transparency"]
	else
		Obj.TextColor3 = Obj:GetAttribute("Color") or Theme["Main Text Color"]
		Obj.TextTransparency = Theme["Main Text Transparency"]
	end
end

const Metatables = {}
const Inputs = {}

function New_Input(Key,Call)
	if not IsA(Call,"function") then
		warn(`Function Submitted To {Key} Is Not A Function`)
		return
	end

	if not Inputs[Enum.KeyCode[Key]] then
		Inputs[Enum.KeyCode[Key]] = Call
	else
		warn(`Input {Key} Already Exists`)
	end

end

function New_Metatable(Name,Info)
	Metatables[Name] = Info
	Metatables[Name].__index = Metatables[Name]

	return Metatables[Name]
end

function Save_Props(Obj : GuiObject)
	for _, Prop in (Obj.Name == "Buttons" or Obj:FindFirstAncestor("Buttons")) and Get_Cache("Visibility-Props") or Get_Cache("Props") do
		if Has_Property(Obj,Prop) then
			if Prop == "BackgroundTransparency" and Obj.Name == "Buttons" then continue end
			Obj:SetAttribute(Prop,Obj[Prop])
		end
	end
end

const function Visibility_Props(Obj,Value)
	const Props = {}

	for _, Prop in Get_Cache("Visibility-Props") do
		if Has_Property(Obj,Prop) and not (Prop == "Transparency" and IsA_TextObj(Obj)) then
			Props[Prop] = Value and Obj:GetAttribute(Prop) or 1
		end
	end

	return Props
end

const function Ancestor_Has_Tag(Obj,Tag)
	while Obj do
		if Obj:HasTag(Tag) then
			return true
		end

		Obj = Obj.Parent
	end

	return false
end

function Hide(Obj : GuiObject,Only_Descendants,Include_Descendants,OnEnd,Visible)
	if Obj:IsA("UIGradient") then return end
	if Ancestor_Has_Tag(Obj,"Dont-Hide") then return end

	if not Only_Descendants then
		Tween({Props = Visibility_Props(Obj,false),Obj = Obj,Info = "Visibility"})
	end

	if Include_Descendants or Only_Descendants then
		for _, Desc in Obj:GetDescendants() do
			Hide(Desc,false,false)
		end

		if (Obj:IsA("GuiObject") and Visible) then
			DelayService.Delay(`Hiding-{Obj.Name}`,.5,function()
				Obj.Visible = false
				if OnEnd then
					OnEnd()
				end
			end)
		end
	end

end

function Show(Obj : GuiObject,Only_Descendants,Include_Descendants,Visible)
	if Obj:IsA("UIGradient") then return end
	if Ancestor_Has_Tag(Obj,"Dont-Show") or not Has_Property(Obj,"Transparency") then return end

	if Obj:IsA("GuiObject") then
		if Visible then
			Obj.Visible = true
		end

		if not Obj:FindFirstAncestorOfClass("ScreenGui").Enabled and
			Obj:FindFirstAncestor("Content") and not Obj.Visible then return end
	end

	if not Only_Descendants then
		Tween({Props = Visibility_Props(Obj,true),Obj = Obj,Info = "Visibility"})
	end

	if Include_Descendants or Only_Descendants then
		for _, Desc in Obj:GetDescendants() do
			Show(Desc,false,false)
		end
	end
end

