const function Get_Cache(Name : string)
	if not Cache[Name] then
		Cache[Name] = {}
	end

	return Cache[Name]
end

const function Has_Property(Obj : Instance,Prop : string)
	const Success = pcall(function()
		const _ = Obj[Prop]
	end)

	return Success
end

const function IsA(Obj : any,Type : string)
	return typeof(Obj) == Type
end

function IsA_TextObj(Obj)
	return Has_Property(Obj,"Text")
end

function IsA_ImageObj(Obj)
	return Has_Property(Obj,"Image")
end

const function Rebuild(Original, Changes)
	if not IsA(Original,"table") then
		return Original
	end

	const Result : typeof(Original) = table.clone(Original)

	if Changes then
		for Key, Value in Changes do
			Result[Key] = IsA(Value,"table") and Rebuild(Original[Key],Value) or Value
		end
	end

	return Result
end

