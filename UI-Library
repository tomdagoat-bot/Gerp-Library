const function Tween(Info : {Props: string | {string} | {any}, Properties: string | {string} | {any}, Obj: GuiObject | Instance, GuiObject: GuiObject | Instance, Info: string | TweenInfo, Tweening: string | TweenInfo, Goal: nil | any, Yield : boolean, OnEnd:()->(), UnCancelable : boolean}) : Tween
	const Obj = Info.Obj or Info.GuiObject
	local Props = Info.Props or Info.Properties
	const TweenInfoValue = Info.Info or Info.Tweening

	if not Obj or not Props then
		error("Tween Requires Obj / GuiObject And Props / Properties")
	end

	const Active = Get_Cache("Tweens")[Obj]
	if Active and not Obj:HasTag("Tween") then
		Active:Cancel()
	end

	if IsA(Props,"string") then

		Props = {[Props] = Info.Goal}

	elseif Info.Goal ~= nil then
		const New_Props = {}

		for _, Prop in Props do
			New_Props[Prop] = Info.Goal
		end

		Props = New_Props
	end

	if Info.UnCancelable then
		Obj:AddTag("Tween")
	end

	const TI = IsA(TweenInfoValue,"string") and Get_Cache("TweenInfos")[TweenInfoValue] or TweenInfoValue
	const Result = TweenService:Create(Obj, TI, Props)
	Get_Cache("Tweens")[Obj] = Result

	Result.Completed:Once(function()
		Obj:RemoveTag("Tween")
		if Info.OnEnd then
			Info.OnEnd()
		end
	end)

	Result:Play()

	if Info.Yield then
		Result.Completed:Wait()
	end

	return Result
end

