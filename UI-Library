function Shared_Metatable(Name,Metatable,Other_Metatable)
	const New_Metatable = New_Metatable(Name,Metatable)

	for Method_Name, Method in Metatables[Other_Metatable or "Object"] do
		if Method_Name == "__index" or Metatables[Name][Method_Name] then continue end
		Metatables[Name][Method_Name] = Method
	end

	return New_Metatable
end

Shared_Metatable("Button",{
	Click = function(self)
		if not self.Active then return end

		const S = self.Info.Sound

		task.spawn(self.Info.CallBack)

		if self.Info.Animated then
			if self.Animating then return end
			self.Animating = true

			const SA = self.UI.Size
			const SI = SA.Y

			const P = self.UI.Padding

			const PL = P.PaddingLeft
			const PR = P.PaddingRight

			Tween({Obj = P,Info = "Quick-Pop (Out)",Props = {PaddingLeft = UDim.new(0,PL.Offset * 1.15),PaddingRight = UDim.new(0,PR.Offset * 1.15)}})	

			Tween({Obj = self.UI,Info = "Quick-Pop (Out)",Props = {Size = UDim2.new(0,0,SI.Scale * 1.15,SI.Offset * 1.15)},OnEnd = function()
				Tween({Obj = self.UI,Info = "Quick-Pop (In)",Props = {Size = SA}})
				Tween({Obj = P,Info = "Quick-Pop (In)",Props = {PaddingLeft = PL,PaddingRight = PR},OnEnd = function()
					self.Animating = false
				end})	
			end,})
		end

		if S.Enabled then
			SoundService:PlayLocalSound(S.Sound)
		end
	end,
})

Shared_Metatable("Toggle",{
	Toggle = function(self,Visual : boolean,DontTween : boolean)
		Visual = Visual ~= nil and Visual or true
		Visual = not Visual
		if not self.Active and Visual then return end

		self[self.Value and "Disable" or "Enable"](self,Visual,DontTween)
	end,

	Enable = function(self,Visual : boolean,DontTween)
		const T = self.Parent.Window.CurrentTheme
		const C = T["Toggled"]

		const S = self.Info.Sound

		if (DontTween and DontTween ~= nil) or not self.Info.Animated then
			self.Button.Click.Position = self.Button.Click:GetAttribute("On")
			self.Button.BackgroundColor3 = C
			self.Button.Glow.Color = C
		else
			Tween({GuiObject = self.Button.Click,Tweening = "Pop",Properties = "Position",Goal = self.Button.Click:GetAttribute("On")})
			Tween({GuiObject = self.Button,Tweening = "Re-Size",Properties = "BackgroundColor3",Goal = C})
			Tween({GuiObject = self.Button.Glow,Tweening = "Re-Size",Properties = "Color",Goal = C})	
		end

		if not Visual then
			self.Value = true
			self.Button:AddTag("Enabled")

			if S.Enabled then
				SoundService:PlayLocalSound(S.OnEnabled or S.Sound)
			end

			if self.Info.CallBack then
				self.Info.CallBack(true)
			end

			if self.Info.OnEnabled then
				self.Info.OnEnabled()
			end
		end
	end,

	Disable = function(self,Visual : boolean,DontTween)
		const T = self.Parent.Window.CurrentTheme
		const C = T["Not Toggled"]

		const S = self.Info.Sound

		if (DontTween and DontTween ~= nil) or not self.Info.Animated then
			self.Button.Click.Position = self.Button.Click:GetAttribute("Off")
			self.Button.BackgroundColor3 = C
			self.Button.Glow.Color = C
		else
			Tween({GuiObject = self.Button.Click,Tweening = "Pop",Properties = "Position",Goal = self.Button.Click:GetAttribute("Off")})
			Tween({GuiObject = self.Button,Tweening = "Re-Size",Properties = "BackgroundColor3",Goal = C})
			Tween({GuiObject = self.Button.Glow,Tweening = "Re-Size",Properties = "Color",Goal = C})	
		end

		if not Visual then
			self.Value = false
			self.Button:RemoveTag("Enabled")

			if S.Enabled then
				SoundService:PlayLocalSound(S.OnDisabled or S.Sound)
			end

			if self.Info.CallBack then
				self.Info.CallBack(false)
			end

			if self.Info.OnDisabled then
				self.Info.OnDisabled()
			end
		end
	end,
})

Shared_Metatable("Slider",{
	Update = function(self,Input)
		if not self.Active then return end

		const Bar = self.Bar
		const Alpha = math.clamp((Input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X,0,1)

		self:Set(self.Min + (self.Max - self.Min) * Alpha)
	end,

	Set = function(self,Value,DontTween)
		if not self.Active then return end

		Value = math.clamp(Value,self.Min,self.Max)

		const Step = self.Info.Step or 0

		if Step > 0 then
			const Chunks = self.Max / Step
			const Increment = (self.Max - self.Min) / Chunks

			Value = self.Min + math.round((Value - self.Min) / Increment) * Increment
			Value = math.clamp(Value,self.Min,self.Max)
		end

		if Value == self.Value then
			return
		end

		self.Value = Value

		const Alpha = (self.Max == self.Min) and 0 or (Value - self.Min) / (self.Max - self.Min)

		const Fill_Goal = UDim2.new(Alpha,0,1,0)

		const Thumb_Pos = self.Thumb.Position
		const Thumb_Goal = UDim2.new(Alpha,0,Thumb_Pos.Y.Scale,Thumb_Pos.Y.Offset)

		if DontTween then
			self.Fill.Size = Fill_Goal
			self.Thumb.Position = Thumb_Goal
		else
			Tween({Obj = self.Fill,Info = "Slider",Props = "Size",Goal = Fill_Goal})
			Tween({Obj = self.Thumb,Info = "Slider",Props = "Position",Goal = Thumb_Goal})
		end

		self.Value_UI.Text = `{Value}{self.Info.Suffix or ""}`

		self.Info.CallBack(Value)
	end,
})

